{
  "multipart": [
    {
      "apply": {
        "model": "wflib:block/drone_net_post_ends"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_post"
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_cap"
      },
      "when": {
        "east": "false",
        "north": "true",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_cap",
        "y": 90
      },
      "when": {
        "east": "true",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_cap_alt"
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "true",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_cap_alt",
        "y": 90
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_side_alt"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "wflib:block/drone_net_side_alt",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    }
  ]
}